        .tooltips-mess {
            position: fixed;
            bottom: 220px;
            right: 20px;
            background-color: white;
            border-radius: 5px;
            padding: 15px 0;
            -webkit-transition: 0.3s all;
            transition: 0.3s all;
            -webkit-transform: scale(0);
            transform: scale(0);
            -webkit-box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
        }

        .tooltips-mess::before {
            content: '';
            position: absolute;
            bottom: -13px;
            right: 25px;
            width: 0;
            height: 0;
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 15px solid white;
        }

        .tooltips-mess a {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            padding: 5px 40px 5px 15px;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            font-size: 20px;
            width: 100%;
        }

        .tooltips-mess a:hover {
            background-color: #ccc;
        }

        .tooltips-mess .icon-ct {
            width: 50px;
            height: 50px;
            background-color: red;
            border-radius: 50%;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            font-size: 28px;
            color: white;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            margin-right: 15px;
        }

        .tooltips-mess .icon-ct b {
            font-size: 18px;
        }

        .open-tool {
            -webkit-transform: scale(1);
            transform: scale(1);
        }
    </style>

    <script>
        function showToast(message, type, isReload) {
            let bgColor = "green";
            switch (type) {
                case 1:
                    bgColor = "red"
                    break;
                case 2:
                    bgColor = "#ffc107"
                    break;
                case 3:
                    bgColor = "blue"
                    break;
                default:
                    bgColor = "green";
                    break;
            }
            Toastify({
                text: message,
                duration: 3000,
                gravity: "top", // Vị trí top
                position: "right", // Hiển thị bên phải
                backgroundColor: bgColor,
            }).showToast();
            if (isReload) {
                setTimeout(
                    function () {
                        window.location.reload();
                    },
                    1000
                );
            }
        }

        function disableButton() {
            // Chọn tất cả các button và link (a) trên trang
            const elements = document.querySelectorAll('button, a');

            elements.forEach(el => {
                // Thêm lớp 'disabled' để hiển thị trạng thái không hoạt động
                el.classList.add('disabled');

                // Disable nút nếu là button
                if (el.tagName.toLowerCase() === 'button') {
                    el.disabled = true;
                }

                // Ngăn chặn hành động mặc định nếu là link (a)
                if (el.tagName.toLowerCase() === 'a') {
                    el.addEventListener('click', function (event) {
                        event.preventDefault();
                    });
                }
            });
        }

        function enableButton() {
            // Chọn tất cả các button và link (a) có lớp 'disabled'
            const elements = document.querySelectorAll('button, a');

            elements.forEach(el => {
                // Xóa lớp 'disabled' để khôi phục trạng thái hoạt động
                el.classList.remove('disabled');

                // Bật lại nút nếu là button
                if (el.tagName.toLowerCase() === 'button') {
                    el.disabled = false;
                }

                // Loại bỏ sự kiện 'click' ngăn hành động mặc định nếu là link (a)
                if (el.tagName.toLowerCase() === 'a') {
                    const newElement = el.cloneNode(true); // Tạo bản sao không có sự kiện
                    el.replaceWith(newElement); // Thay thế thẻ hiện tại bằng bản sao
                }
            });
        }
    </script>

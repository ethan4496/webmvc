@using WebMVC.Models.Responses
@model List<PostResponse>
<div id="table-container">
    <div class="table-content">
        <table class="table table-hover table-bordered">
            <thead class="table">
                <tr>
                    <th class="text-center">#</th>
                    <th class="text-center" style=" width: 100px; "></th>
                    <th class="text-center">Title</th>
                    <th class="text-center">Mô tả</th>
                    <th class="text-center">Danh mục</th>
                    <th class="text-center">Ngày tạo</th>
                    <th class="text-center">Tác giả</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td class="text-center align-content-center">@((ViewBag.CurrentPage - 1) * (ViewBag.PageSize) + i + 1)</td>
                        <td class="text-center align-content-center">
                            <div class="d-flex justify-content-center align-content-center">
                                @if (!string.IsNullOrWhiteSpace(Model[i].Image))
                                {
                                    <img src="@Model[i].Image" class="img-fluid rounded border" style="max-width: 80px; max-height: 80px;" alt="Category Image">
                                }
                            </div>
                        </td>
                        <td class="text-center align-content-center">@Model[i].Title</td>
                        <td class="text-center align-content-center">@Model[i].Excerpt</td>
                        <td class="text-center align-content-center">@string.Join(", ", Model[i].Categories.Select(c => c.Name))</td>
                        <td class="text-center align-content-center">@Model[i].Created.ToString("dd/MM/yyyy")</td>
                        <td class="text-center align-content-center">
                            <p>
                                <a class="btn btn-sm btn-warning" href="/post/@Model[i].Id">Cập nhật</a>
                            </p>
                            <p>
                                <button class="btn btn-sm btn-danger" onclick="deletePost(@Model[i].Id)">Xóa</button>
                            </p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count > 0)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end">
                @if (ViewBag.CurrentPage > 2)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0);" onclick="loadPage(1)">Đầu</a>
                    </li>
                }
                @{
                    int startPage = Math.Max(1, ViewBag.CurrentPage - 1);
                    int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 1);
                }
                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="javascript:void(0);" onclick="loadPage(@i)">@i</a>
                    </li>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages - 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="javascript:void(0);" onclick="loadPage(@ViewBag.TotalPages)">Cuối</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

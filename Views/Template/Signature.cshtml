@using WebMVC.Entities
@using WebMVC.Models.Responses
@using WebMVC.Interfaces
@using WebMVC.Models.Requests.Creates
@using WebMVC.Ultilities.Enums
@model AccountSignature
@inject IHttpContextService _httpContextService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@{
    var loggedModel = _httpContextService.GetLoggedModel();
    var defaultLogo = System.IO.File.ReadAllText(System.IO.Path.Combine(_env.WebRootPath, "templates", "DefaultLogo.html"));
    var defaultSignature = System.IO.File.ReadAllText(System.IO.Path.Combine(_env.WebRootPath, "templates", "DefaultSignature.html"));
    var content = Model?.Body ?? defaultSignature;
}

<div class="container-fluid mt-4">
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2>Signature của bạn</h2>
        </div>
        <form action="/signature" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" id="logoPath" name="LogoPath" value="@Model?.Logo" />
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Logo</label>
                        <div class="d-flex align-items-center gap-3">
                            <div id="logo-preview" style="width:120px;height:80px;border:1px dashed #ccc;border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f8f9fa;">
                                @if (!string.IsNullOrEmpty(Model?.Logo))
                                {
                                    <img src="@Model.Logo" id="logo-img" style="max-width:100%;max-height:100%;object-fit:contain;" />
                                }
                                else
                                {
                                    <span id="logo-placeholder" class="text-muted" style="font-size:12px;">No logo</span>
                                }
                            </div>
                            <div>
                                <input type="file" id="logo-file" accept="image/*" class="form-control" style="width:220px;" />
                                <div id="logo-upload-status" class="text-muted mt-1" style="font-size:12px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-xs-12 mb-3">
                        <label class="form-label">Content</label>
                        <div>
                            <textarea id="body" name="Body">
                                @content
                            </textarea>
                        </div>
                    </div>
                    <div class="col-md-6 col-xs-12 mb-3">
                        <label class="form-label">Preview</label>
                        <div id="preview-template">
                            <iframe id="preview-iframe" style="width:100%;min-height:400px;border:1px solid #dee2e6;border-radius:4px;" frameborder="0"></iframe>
                        </div>
                    </div>
                </div>
                <div class="row pt-2">
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary btn-search">Save</button>
                    </div>
                </div>

            </div>
        </form>
    </div>
    <div id="loading" style="display: none;">
        <div class="loading-overlay">
            <div class="spinner"></div>
        </div>
    </div>
    @section Scripts {
        <script src="~/lib/tinymce/js/tinymce/tinymce.min.js"></script>
        <script src="~/js/template.js" asp-append-version="true"></script>
        <script>
            var logoTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultLogo));

            function buildPreviewHtml(bodyContent) {
                var logoUrl = document.getElementById('logoPath').value;
                var logoHtml = logoTemplate.replace('{{Logo}}', logoUrl);
                return '<table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">'
                     + '<tr><td style="direction:ltr;font-size:0px;padding:0;text-align:center;">'
                     + logoHtml + bodyContent
                     + '</td></tr></table>';
            }

            function updatePreview(bodyContent) {
                var iframe = document.getElementById('preview-iframe');
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                var css = `<style>
                    @@media only screen and (min-width:480px) {
                        .mj-column-per-100 { width: 100% !important; max-width: 100%; }
                        .mj-column-per-20 { width: 20% !important; max-width: 20%; }
                        .mj-column-per-80 { width: 80% !important; max-width: 80%; }
                    }
                </style>`;
                doc.open();
                doc.write(css + buildPreviewHtml(bodyContent));
                doc.close();
            }

            tinymce.init({
                selector: '#body',
                license_key: 'gpl',
                setup: function(editor) {
                    editor.on('init', function() {
                        updatePreview(editor.getContent());
                    });
                    editor.on('input change keyup', function() {
                        updatePreview(editor.getContent());
                    });
                }
            });

            document.getElementById('logo-file').addEventListener('change', function() {
                var file = this.files[0];
                if (!file) return;

                var statusEl = document.getElementById('logo-upload-status');
                statusEl.textContent = 'Đang tải lên...';

                var formData = new FormData();
                formData.append('file', file);

                fetch('/signature/upload-logo', { method: 'POST', body: formData })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        var url = data.path;
                        document.getElementById('logoPath').value = url;
                        statusEl.textContent = '';

                        var preview = document.getElementById('logo-preview');
                        var img = preview.querySelector('img');
                        if (!img) {
                            preview.innerHTML = '';
                            img = document.createElement('img');
                            img.id = 'logo-img';
                            img.style = 'max-width:100%;max-height:100%;object-fit:contain;';
                            preview.appendChild(img);
                        }
                        img.src = url;

                        var editor = tinymce.get('body');
                        if (editor) updatePreview(editor.getContent());
                    })
                    .catch(function() {
                        statusEl.textContent = 'Tải lên thất bại';
                    });
            });

        </script>
        <style>
            [data-bs-toggle="tooltip"] {
            cursor: pointer;
            }
        </style>
    }
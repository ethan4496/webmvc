@{
    Layout = "~/Views/Shared/_NewHomeLayout.cshtml";
    ViewData["Title"] = "Trang chủ";
}
@using WebMVC.Models.ViewModels
@model HomeViewModel
<section class="banner">
    <div class="swiper" id="banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <img src="/tpkexpress/images/home/Banner1.png" alt="Banner">
            </div>
            <div class="swiper-slide">
                <img src="/tpkexpress/images/home/banner2.png" alt="Banner">
            </div>
            <div class="swiper-slide">
                <img src="/tpkexpress/images/home/banner3.png" alt="Banner">
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</section>
<section class="find-transportation">
    <div class="container">
        <h2 class="section-title text-center">
            Tra cứu mã vận đơn
        </h2>
        <p class="mb-0 text-center description">
            Cập nhật trạng thái đơn hàng nhanh chóng qua website, app và Zalo.
        </p>
        <div class="form-transportation">
            <form action="/tra-cuu" method="get">
                <div class="form-container d-flex flex-column flex-md-row">
                    <div class="input-search-transportation">
                        <img src="/tpkexpress/images/icon/Search.svg" alt="Search">
                        <input name="Barcode" id="Barcode" placeholder="Nhập mã vận đơn (VD: TPK-2024-12345)" />
                    </div>
                    <button class="btn btn-orange" type="submit">Tra cúu ngay</button>
                </div>
            </form>
        </div>
        <div class="result-transportation">
            <div class="transportation-status">
                <div class="text">
                    Trạng thái đơn:
                </div>
                <div class="status-tag badge-progress">
                    Đang xử lý
                </div>
            </div>
        </div>
    </div>
</section>
<section class="news">
    <div class="container">
        <div class="text-heading text-center">Tin tức</div>
        <h2 class="section-title-extra text-center">Tin tức TPK Express</h2>
        <p class="description-lg text-center">Cập nhật mới nhất từ đội ngũ TPK Express</p>
        <div class="news-list">
            @foreach (var post in Model.LatestPosts)
            {
                <div class="new-card">
                    <div class="new-img">
                        <img src="@post.Image" alt="News">
                    </div>
                    <div class="new-content-inner">
                        <div class="new-content">
                            <div class="new-created">
                                <div class="status-tag badge-progress">@post.Categories.FirstOrDefault()?.Name</div>
                                <span>@post.Created.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="new-title">
                                <a href="/tin-tuc/@post.Slug">
                                    @post.Title
                                </a>
                            </div>
                            <div class="new-description">
                                @post.Excerpt
                            </div>
                        </div>
                        <a href="/tin-tuc/@post.Slug" class="btn read-nore">
                            <span>Đọc thêm </span>
                            <img src="/tpkexpress/images/icon/ArrowRight.svg" alt="ArrowRight">
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="view-all">
            <a href="/tin-tuc" class="btn btn-border-orrange">
                <span>Xem tất cả tin tức</span>
                <img src="/tpkexpress/images/icon/ArrowRight.svg" alt="ArrowRight">
            </a>
        </div>
    </div>
</section>
<section class="services">
<div class="container">
<div class="text-heading text-center">Dịch vụ</div>
<h2 class="section-title-extra text-center">Dịch vụ dành cho người nhập hàng Trung Quốc</h2>
<p class="description-lg text-center mb-0">Từ mua hộ, ký gửi đến vận chuyển chính ngạch — TPK Express
giúp chủ shop và doanh nghiệp Việt nhập hàng dễ hơn, rõ phí hơn và theo dõi đơn thuận tiện hơn.</p>
<div class="service-inner">
<div class="service-order">
<div class="circle-blur">
<picture>
<source media="(min-width: 1025px)" srcset="/tpkexpress/images/home/CircleLg.png">
<source media="(min-width: 768px)" srcset="/tpkexpress/images/home/CircleTablet.png">
<img src="/tpkexpress/images/home/Circle.png" alt="Circle">
</picture>
</div>
<div class="rect-blur">

</div>
<div class="service-tag">
<ul>
<li>Taobao / 1688 / Tmall</li>
<li class="hightlight">3-5 ngày</li>
<li>Theo dõi đơn</li>
</ul>

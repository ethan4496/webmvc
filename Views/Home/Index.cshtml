                <div class="procedure-des">Đơn hàng được cập nhật trạng thái trong quá trình vận chuyển.
                </div>
            </div>
        </div>
        <div class="procedure-item highlight">
            <div class="procedure-icon">
                <img src="/tpkexpress/images/home/procedure/Messenger.svg" />
            </div>
            <div class="procedure-data">
                <div class="procedure-number">06</div>

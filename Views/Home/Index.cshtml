        <img src="/tpkexpress/images/home/procedure/Headphone.svg" />
    </div>
    <div class="procedure-data">
        <div class="procedure-number">02</div>
        <h4>Tư vấn tuyến & chi phí</h4>
        <div class="procedure-des">TPK đề xuất phương án phù hợp theo loại hàng, thời gian và
            ngân sách.</div>
        </div>
    </div>
    <div class="procedure-item">

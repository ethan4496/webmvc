<section class="revise-section">
    <div class="container">
        <div class="revise-inner">
            <div class="revise-heading">
                <div class="text-heading">TƯ VẤN MIỄN PHÍ</div>
                <h2 class="section-title-extra">Đăng ký tư vấn miễn phí</h2>
                <p class="description-lg mb-0">Đội ngũ chuyên gia TPK Express sẵn sàng tư vấn phương án phù hợp
                    nhất — hoàn toàn miễn phí.</p>
                    <div class="image-revise">
                        <img src="/tpkexpress/images/home/ContactForm.jpg" alt="Revise">
                    </div>
                </div>
                <div class="revise-form">
                    <form action="" id="revise-form">
                        <h3>Để lại thông tin — TPK gọi lại ngay!</h3>
                        <div class="input-group">
                            <div class="input-item">
                                <label for="name" class="form-label">Họ tên *</label>
                                <input type="text" class="form-control" id="name" placeholder="Nguyễn Văn A">
                            </div>
                            <div class="input-item">
                                <label for="phone_number" class="form-label">Số điện thoại *</label>
                                <input type="tel" class="form-control" id="phone_number" placeholder="0901 234 567">
                            </div>
                        </div>
                        <div class="input-item">
                            <label for="name" class="form-label">Bạn là</label>
                            <input type="text" class="form-control" id="name" placeholder="">
                        </div>
                        <div class="input-item">
                            <label for="email" class="form-label">Email (tuỳ chọn)</label>
                            <input type="text" class="form-control" name="email" id="email" placeholder="email@example.com">
                        </div>
                        <div class="input-item">
                            <label for="content" class="form-label">Nội dung cần tư vấn</label>
                            <textarea name="content" class="form-control" id="content"
                                        placeholder="VD: Muốn nhập quần áo từ Taobao, 30–50 kg/tháng...">

</textarea>
                        </div>
                        <div class="input-item">
                            <button class="btn btn-orange" type="submit">
                                Đăng ký ngay
                            </button>
                        </div>

                        <p class="form-note text-center">TPK sẽ liên hệ trong vòng 24 giờ làm việc.</p>
                    </form>
                </div>
            </div>
        </div>
    </section>
<div class="modal modal-intro" id="modal-intro" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">

            </div>
            <div class="modal-body">
                <button type="button" class="close-body" data-bs-dismiss="modal" aria-label="Close">
                    <img src="/tpkexpress/images/dialog/CloseWhite.svg" alt="">
                </button>
                <div class="tpkexpress-notification">
                    <div class="logo-tpkexpress">
                        <img src="/tpkexpress/images/dialog/Logo.svg" alt="Logo">
                    </div>
                    <div class="icon-notification-alert">
                        <img src="/tpkexpress/images/dialog/Alert.svg" alt="Alert">
                    </div>
                    <div class="heading-notification">
                        Thông báo vận chuyển
                    </div>
                    <h2>@Model.webConfiguration.NotiTitle</h2>
                    <p>TPK Express gửi thông tin mới nhất để quý khách chủ động kế hoạch nhận hàng trong giai
                        đoạn kiểm tra cao điểm.</p>
                </div>
                <div class="content-notification">
                    <div class="content-notification-top">
                        <div class="waring-notification">
                            <div class="warning-icon">
                                <img src="/tpkexpress/images/dialog/Warning.svg" alt="Warning" />
                            </div>
                            <div class="warning-text">
                                <h3>Kính gửi Quý khách hàng</h3>
                                <p>Hà Nội, ngày @Model.webConfiguration.Updated?.ToString("dd \"tháng\" MM \"năm\" yyyy")</p>
                            </div>
                        </div>
                        <div class="d-flex flex-column warning-desc">
                            <p>
                                @Html.Raw(Model.webConfiguration.NotiContent)
                            </p>
                        </div>
                    </div>
                    <div
                        class="mt-3 d-flex gap-3 flex-md-row flex-column justify-content-between align-items-start">
                        <a href="/tra-cuu" class="btn btn-dialog">
                            <span>
                                Tra cứu vận đơn
                            </span>
                            <svg width="15" height="15" viewBox="0 0 15 15" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M3.12231 7.49316H11.8645" stroke="white" stroke-width="1.24888"
                                    stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M7.49341 3.12207L11.8645 7.49316L7.49341 11.8643" stroke="white"
                                    stroke-width="1.24888" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                        <button type="button" class="btn btn-knowledge" data-bs-dismiss="modal"
                            aria-label="Close">
                            Tôi đã hiểu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
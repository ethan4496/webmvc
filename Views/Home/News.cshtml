@using WebMVC.Models.ViewModels
@model NewsViewModel
@{
    Layout = "~/Views/Shared/_NewHomeLayout.cshtml";
    ViewData["Title"] = "Tin tức";
}
<section class="page-breadcrumb">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tin tức</li>
            </ol>
        </nav>
        <div class="breadcrumb-head">
            <h1 class="section-title">Tin tức TPK Express</h1>
        </div>
        <p class="description-lg mb-0">Cập nhật mới nhất về dịch vụ, hướng dẫn nhập hàng và tin tức ngành
            logistics</p>
        <div class="form-search">
            <form action="">
                <div class="form-group">
                    <img src="/tpkexpress/images/icon/Search.svg" alt="">
                    <input type="text" class="form-control" id="title" name="title"
                        placeholder="Tìm kiếm bài viết...">
                </div>
            </form>
        </div>
    </div>
</section>
<section class="post-categories">
    <div class="container">
        <div class="categories">
            <ul class="d-flex ">
                <li class="active" data-id="">Tất cả</li>
                @foreach (var category in (IEnumerable<dynamic>)Model.Categories)
                {
                    <li data-id="@category.Id">@category.Name</li>
                }
            </ul>
        </div>
    </div>
</section>
<section class="section-posts">
    <div class="container">
        <div class="sectin-posts-wrapper">
            <div class="primary-post">
                <div class="title-primary">
                    Nổi bật
                </div>
                <div class="article">
                    <div class="image-article">
                        <img src="@Model.PrimaryPost.Image" alt="PrimaryArticle" />
                    </div>
                    <div class="article-info">
                        <div class="article-heading">
                            <div class="article-tag">
                                <div class="status-tag badge-progress">
                                    @Model.PrimaryPost.Categories.FirstOrDefault()?.Name
                                </div>
                                <div class="d-flex align-items-center gap-1 time-read">
                                    <img src="/tpkexpress/images/icon/Clock.svg" alt="">
                                    <span>@Model.PrimaryPost.ReadingTimeMinutes</span>
                                </div>
                                <div class="article-created-at">
                                    @Model.PrimaryPost.Created.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                            <h3>@Model.PrimaryPost.Title</h3>
                            <p>@Model.PrimaryPost.Excerpt</p>
                        </div>
                        <div class="article-readmore">
                            <a href="/tin-tuc/@Model.PrimaryPost.Slug" class="btn read-nore">
                                <span>Đọc thêm </span>
                                <img src="/tpkexpress/images/icon/ArrowRight.svg" alt="ArrowRight">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="other-article">
                @{
                    var otherPosts = Model.Posts.Where(x => x.Id != Model.PrimaryPost?.Id).ToList();
                }
                <div class="result-search">@otherPosts.Count bài viết khác</div>
                <div class="list-articles">
                    @foreach (var post in otherPosts)
                    {
                        <div class="article">
                            <div class="image-article">
                                <img src="@post.Image" alt="@post.Title" />
                            </div>
                            <div class="article-info">
                                <div class="article-heading">
                                    <div class="article-tag">
                                        <div class="status-tag badge-progress">
                                            @post.Categories.FirstOrDefault()?.Name
                                        </div>
                                        <div class="d-flex align-items-center gap-1 time-read">
                                            <img src="/tpkexpress/images/icon/Clock.svg" alt="">
                                            <span>@post.ReadingTimeMinutes phút đọc</span>
                                        </div>
                                        <div class="article-created-at">
                                            @post.Created.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                    <h3>@post.Title</h3>
                                    <p>@post.Excerpt</p>
                                </div>
                                <div class="article-readmore">
                                    <a href="/tin-tuc/@post.Slug" class="btn read-nore">
                                        <span>Đọc thêm </span>
                                        <img src="/tpkexpress/images/icon/ArrowRight.svg" alt="ArrowRight">
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.TotalPages > 1)
                {
                    var pageNumbers = new List<int?>();
                    foreach (var i in Enumerable.Range(1, Model.TotalPages))
                    {
                        if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.CurrentPage) <= 1)
                        {
                            pageNumbers.Add(i);
                        }
                        else if (pageNumbers.Count > 0 && pageNumbers[pageNumbers.Count - 1] != null)
                        {
                            pageNumbers.Add(null);
                        }
                    }
                    <nav aria-label="Phân trang tin tức" class="news-pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage - 1)">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M10.06 12L11 11.06L7.94667 8L11 4.94L10.06 4L6.06 8L10.06 12Z" fill="#0B2D5C"/>
                                    </svg>
                                </a>
                            </li>
                            @foreach (var i in pageNumbers)
                            {
                                if (i == null)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                else
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i">@i</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage + 1)">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M6.94 4L6 4.94L9.05333 8L6 11.06L6.94 12L10.94 8L6.94 4Z" fill="#0B2D5C"/>
                                    </svg>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</section>
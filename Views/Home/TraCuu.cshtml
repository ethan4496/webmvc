@using System.Linq
@using WebMVC.Entities
@using WebMVC.Models.ViewModels
@using WebMVC.Ultilities
@model Transportation
@{
    Layout = "~/Views/Shared/_NewHomeLayout.cshtml";
    ViewData["Title"] = "Tra cứu";
    var barcode = Context.Request.Query["Barcode"].ToString();
    var StatusList = Model == null ? new List<dynamic>() : new List<dynamic>
    {
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtTQWarehouse,
            Label = "Nhập kho TQ",
            Icon = "/tpkexpress/images/tra-cuu/NhapkhoWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/NhapKho.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateArrivedAtTQWarehouse),
            DateAndTime = FormatDate.FormatNullDate(Model.DateArrivedAtTQWarehouse),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtTQWarehouse,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtTQWarehouse,
            Address = "Bằng Tường, Trung Quốc",
            StatusLabel = "Đã nhập kho Trung Quốc",
            Note = "Hàng của bạn đã được nhập kho Trung Quốc"
        },
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.ExitedFromTQWarehouse,
            Label = "Đã phát hàng",
            Icon = "/tpkexpress/images/tra-cuu/PhatHangWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/PhatHang.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateExitedFromTQWarehouse),
            DateAndTime = FormatDate.FormatNullDate(Model.DateExitedFromTQWarehouse),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.ExitedFromTQWarehouse,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.ExitedFromTQWarehouse,
            Address = "Bằng Tường, Trung Quốc",
            StatusLabel = "Đã được xếp xe chờ vận chuyển",
            Note = "Hàng của bạn đã được xếp xe chờ vận chuyển"
        },
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.CustomsInspectedGoods,
            Label = "Kiểm hóa",
            Icon = "/tpkexpress/images/tra-cuu/KiemHoaWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/KiemHoa.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateCustomsInspectedGoods),
            DateAndTime = FormatDate.FormatNullDate(Model.DateCustomsInspectedGoods),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.CustomsInspectedGoods,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.CustomsInspectedGoods,
            Address = "Cửa khẩu Hữu Nghị",
            StatusLabel = "Đang trong quá trình kiểm hóa",
            Note = "Đơn hàng của bạn đang trong quá trình kiểm hóa"
        },
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.ReturningToVNWarehouse,
            Label = "Đang nhập khẩu",
            Icon = "/tpkexpress/images/tra-cuu/NhapKhauWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/NhapKhau.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateReturningToVNWarehouse),
            DateAndTime = FormatDate.FormatNullDate(Model.DateReturningToVNWarehouse),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.ReturningToVNWarehouse,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.ReturningToVNWarehouse,
            Address = "Cửa khẩu Hữu Nghị",
            StatusLabel = "Đang làm thủ tục nhập khẩu",
            Note = "Hàng đang trong quá trình thông quan và nhập khẩu"
        },
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtVNWarehouse,
            Label = "Nhập kho HN",
            Icon = "/tpkexpress/images/tra-cuu/HomeWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/Home.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateArrivedAtVNWarehouse),
            DateAndTime = FormatDate.FormatNullDate(Model.DateArrivedAtVNWarehouse),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtVNWarehouse,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.ArrivedAtVNWarehouse,
            Address = "Kho TPK Hà Nội",
            StatusLabel = "Đã về kho Hà Nội",
            Note = "Đơn hàng của bạn đã nhập kho Hà Nội"
        },
        new {
            Value = (int)WebMVC.Ultilities.Enums.ETransportationStatus.Completed,
            Label = "Đã xuất kho",
            Icon = "/tpkexpress/images/tra-cuu/CompleteWhite.svg",
            IconActive = "/tpkexpress/images/tra-cuu/Complete.svg",
            Date = FormatDate.FormatDateTraCuu(Model.DateCompleted),
            DateAndTime = FormatDate.FormatNullDate(Model.DateCompleted),
            isComplete = Model.Status >= (int)WebMVC.Ultilities.Enums.ETransportationStatus.Completed,
            isActive = Model.Status == (int)WebMVC.Ultilities.Enums.ETransportationStatus.Completed,
            Address = "Kho TPK Hà Nội",
            StatusLabel = "Đã xuất kho",
            Note = "Đơn hàng đã được gửi tới địa chỉ của bạn"
        },
    };
    var statusMap = StatusList.FirstOrDefault(s => s.isActive);
}
<section class="banner">
    <div class="swiper" id="banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <img src="tpkexpress/images/home/Banner1.png" alt="Banner">
            </div>
            <div class="swiper-slide">
                <img src="tpkexpress/images/home/Banner8.png" alt="Banner">
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>
</section>
<section class="find-transportation">
    <div class="container">
        <h2 class="section-title text-center">
            Tra cứu mã vận đơn
        </h2>
        <p class="mb-0 text-center description">
            Cập nhật trạng thái đơn hàng nhanh chóng qua website, app và Zalo.
        </p>
        <div class="form-transportation">
            <form action="/tra-cuu" method="get">
                <div class="form-container d-flex flex-column flex-md-row">
                    <div class="input-search-transportation">
                        <img src="/tpkexpress/images/icon/Search.svg" alt="Search">
                        <input name="Barcode" id="Barcode" value="@barcode" placeholder="Nhập mã vận đơn (VD: TPK-2024-12345)">
                    </div>
                    <button class="btn btn-orange" type="submit">Tra cúu ngay</button>
                </div>
            </form>
        </div>
    </div>
</section>
<section class="section-result" id="result">
    @if(Model == null){
        <div class="no-exists">
            <div class="no-exists-content">
                <h2 class="text-center">Rất tiếc, đơn hàng không tồn tại</h2>
                <p class="text-center">Chúng tôi không tìm thấy đơn hàng nào khớp với thông tin bạn vừa nhập. Bạn
                    vui lòng kiểm tra lại mã đơn hàng nhé.</p>
                <img src="/tpkexpress//images/tra-cuu/NoExists.png" alt="NoExists" loading="lazy">
            </div>
            <a href="/" class="btn-orange btn">
                Về trang chủ
            </a>
        </div>
    }else{
        <div class="content-result">
            <div class="result-transportation">
                <div class="transportation">
                    <div class="transportation-info">
                        <div class="img-product">
                            <img src="/tpkexpress/images/tra-cuu/Product.svg" alt="Product" loading="lazy" />
                        </div>
                        <div class="transportation-info-detail">
                            <div class="font-normal">Mã vận đơn</div>
                            <div class="transportation-barcode">
                                <span>@Model.Barcode</span>
                                <button type="button" class="btn transportation-barcode-copy">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M19.9302 1.62012H7.27467C5.92737 1.62012 4.83132 2.71947 4.83132 4.07082V4.82959H4.06444C2.71714 4.82959 1.62109 5.92894 1.62109 7.28104V19.9293C1.62109 21.2806 2.71714 22.38 4.06444 22.38H16.7203C18.072 22.38 19.1714 21.2806 19.1714 19.9293V19.1705H19.9302C21.2818 19.1705 22.3816 18.0711 22.3816 16.719V4.07074C22.3815 2.71947 21.2818 1.62012 19.9302 1.62012ZM17.6714 19.9292C17.6714 20.4536 17.2448 20.8799 16.7203 20.8799H4.06444C3.54439 20.8799 3.12109 20.4536 3.12109 19.9292V7.28097C3.12109 6.75657 3.54447 6.32952 4.06444 6.32952H5.58132H16.7203C17.2447 6.32952 17.6714 6.75649 17.6714 7.28097V18.4203V19.9292ZM20.8815 16.719C20.8815 17.2434 20.4549 17.6704 19.9301 17.6704H19.1713V7.28097C19.1713 5.92894 18.072 4.82952 16.7202 4.82952H6.33124V4.07074C6.33124 3.54634 6.75462 3.12004 7.27459 3.12004H19.9301C20.4549 3.12004 20.8815 3.54634 20.8815 4.07074V16.719Z"
                                            fill="#667085" />
                                    </svg>
                                </button>
                            </div>
                            <div class="badge-status">
                                @WebMVC.Ultilities.Enums.ETransportationStatusName.GetStatusName(Model.Status)
                            </div>
                            <div class="transportation-updated">Cập nhật lúc: @FormatDate.FormatNullDate(Model.Updated)</div>
                        </div>
                    </div>
                    <div class="line-transportation"></div>
                    <div class="tracking-status-transportation">
                        @foreach(var status in StatusList){
                            <div class="status-item @(status.isComplete ? "status-complete" : "") @(status.isActive ? "status-active" : "")">
                                <div class="icon-status">
                                    <img src="@(status.isComplete ? status.Icon : status.IconActive)" alt="Nhap kho" />
                                </div>
                                @if(status.isComplete){
                                    <div class="data-status">
                                        <div>
                                            <div class="status-name">@status.Label</div>
                                            <div class="status-change-date">
                                                @status.Date
                                            </div>
                                        </div>
                                        <div class="icon-track">
                                            @if(status.isActive){
                                                <img src="/tpkexpress/images/tra-cuu/StatusCircle.svg" alt="Icon" loading="lazy">
                                            }else{
                                                if(status.isComplete){
                                                    <img src="/tpkexpress/images/tra-cuu/StatusCheck.svg" alt="Icon" loading="lazy">
                                                }
                                            }
                                            
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="information-transportation">
                    <div class="delivery-transportation">
                        <div class="current-status">
                            <div class="label">TRẠNG THÁI HIỆN TẠI</div>
                            <h3>@statusMap?.Label</h3>
                            <p>@statusMap?.DateAndTime</p>
                        </div>
                        <div class="address-nhapkho">
                            <div class="address-nhapkho-item">
                                <div class="icon-address">
                                    <img src="/tpkexpress/images/tra-cuu/Location.svg" alt="Location">
                                </div>
                                <p>Địa điểm</p>
                                <h3>@statusMap?.Address</h3>
                            </div>
                            <div class="address-diviver"></div>
                            <div class="address-nhapkho-item">
                                <div class="icon-address">
                                    <img src="/tpkexpress/images/tra-cuu/Target.svg" alt="Location">
                                </div>
                                <p>Trạng thái</p>
                                <h3>@statusMap?.StatusLabel</h3>
                            </div>
                        </div>
                    </div>
                    <div class="content-transportation">
                        <h3>THÔNG TIN ĐƠN HÀNG</h3>
                        <div class="transportation-warehouse-box">
                            <div class="warehouse-card">
                                <div class="icon-warehouse">
                                    <img src="/tpkexpress/images/tra-cuu/WareHouseStart.svg" alt="" />
                                </div>
                                <div class="warehouse-text">
                                    <p>Kho xuất phát</p>
                                    <h4>Kho Trung Quốc</h4>
                                </div>
                            </div>
                            <div class="warehouse-diviver">
                            </div>
                            <div class="warehouse-card">
                                <div class="icon-warehouse">
                                    <img src="/tpkexpress/images/tra-cuu/WareHouseEnd.svg" alt="" />
                                </div>
                                <div class="warehouse-text">
                                    <p>Kho đích</p>
                                    <h4>Kho Hà Nội</h4>
                                </div>
                            </div>
                            <div class="warehouse-diviver">
                            </div>
                            <div class="warehouse-card">
                                <div class="icon-warehouse">
                                    <img src="/tpkexpress/images/tra-cuu/Clock.svg" alt="" />
                                </div>
                                <div class="warehouse-text">
                                    <p>Cập nhật cuối</p>
                                    <h4>@FormatDate.FormatNullDate(Model.Updated)</h4>
                                </div>
                            </div>
                            <div class="transportation-note">
                                <p>Ghi chú đơn hàng</p>
                                <h4>@statusMap?.Note</h4>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="need-support">
                    <div class="box-support">
                        <div class="support-icon">
                            <img src="/tpkexpress/images/tra-cuu/Support.svg" />
                        </div>
                        <div class="support-text">
                            <h3>Cần hỗ trợ?</h3>
                            <p>Liên hệ đội ngũ chăm sóc khách hàng để được hỗ trợ nhanh chóng.</p>
                        </div>
                    </div>
                    <div class="btn-support">
                        <a href="tel: 0338964163" class="btn btn-hotline">
